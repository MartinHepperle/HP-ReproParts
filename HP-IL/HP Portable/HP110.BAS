1000 REM -- MBASIC-ROM -- HP Portable Plus -- 
1005 REM -- Martin Hepperle, 2026
1010 NX%=100 : UX%=12 : REM max. samples, volts
1020 DIM VOLTS(NX%),TSECS(NX%)
1030 BUFFER$=SPACE$(13) : EC$=CHR$(27)
1040 FX=(480-30)/NX% : FY=(200-20)/UX%
1050 DEF FNX%(X)=20+CINT(FX*X)
1060 DEF FNY%(Y)=10+CINT(FY*Y)
1070 PRINT EC$+"H"+EC$+"J"; : REM home and clear alpha
1080 DEF SEG : REM read DEFSEG from BASIC data segment
1090 BIN.SEG=PEEK(&H4D0)+256*PEEK(&H4D1)+&H1010 : REM above MBASIC 5.28
1100 DEF SEG=BIN.SEG
1110 ON ERROR GOTO 1140
1120 BLOAD "HPIL.BIN",0
1130 GOTO 1180 : REM 2nd or next run if HPIL.BIN exists
1140 A%=0 : REM first run if HPIL.BIN does not exist
1150 READ B$ : IF B$="XX" THEN GOTO 1170
1160 POKE A%,VAL("&H"+B$) : A%=A%+1 : GOTO 1150
1170 BSAVE "HPIL.BIN",0,324
1175 REM first and next runs
1180 CONFIGURE%=0 : GETAID%=3 : ADDRESS%=6
1190 OUTPUT%=9 : ENTERCNT%=12 : ENTERLF%=15
1200 SENDF%=18 : GETF%=21
1210 REM
1220 CALL CONFIGURE%(RET%)
1230 IF RET%=-1 THEN PRINT "ERROR: CONFIGURE" : STOP
1240 REM
1250 ADDR%=8
1260 REM Talker: Portable, Listener: DVM
1270 TALK%=&H1F : LISTEN%=ADDR%
1280 CALL ADDRESS%(TALK%,LISTEN%,RET%)
1290 IF RET%=-1 THEN PRINT "ERROR: ADDRESS" : STOP
1300 REM send REN and wait
1310 A%=&H492 : B%=1
1320 CALL SENDF%(A%,B%,RET%)
1330 IF RET%=-1 THEN PRINT "ERROR: REN" : STOP
1340 REM DCV, 30V, NO Autozero, with END frame
1350 B$="F1R3Z0"+CHR$(13)+CHR$(10) : A%=1
1360 CALL OUTPUT%(B$,A%,RET%)
1370 IF RET%=-1 THEN PRINT "ERROR: OUTPUT" : STOP
1380 REM Talker: DVM, Listener: Portable
1390 TALK%=ADDR% : LISTEN%=&H1F
1400 CALL ADDRESS%(TALK%,LISTEN%,RET%)
1410 IF RET%=-1 THEN PRINT "ERROR: ADDRESS" : STOP
1420 REM plot axes and gridlines
1430 PRINT EC$+"*daC"; : REM clear GRAPHICS, GRAPHICS on
1440 PRINT EC$+"*pa20,189b20,10,469,10Z";
1450 FOR A%=0 TO NX% STEP 10
1460  X%=FNX%(A%) : PRINT EC$+"*pa"+STR$(X%)+",8b"+STR$(X%)+",10Z";
1470 NEXT A%
1480 FOR A%=0 TO UX% STEP 1
1490  Y%=FNY%(A%) : PRINT EC$+"*pa18"+STR$(Y%)+"b20"+STR$(Y%)+"Z";
1500 NEXT A%
1510 PRINT EC$+"*m7B";
1520 FOR A%=0 TO NX% STEP 10
1530  X%=FNX%(A%) : PRINT EC$+"*pa"+STR$(X%)+",10b"+STR$(X%)+",189Z";
1540 NEXT A%
1550 PRINT EC$+"*d18,0O0";
1560 PRINT EC$+"*d445,0O"+str$(NX%);
1570 FOR A%=0 TO UX% STEP 1
1580  Y%=FNY%(A%) : PRINT EC$+"*pa20"+STR$(Y%)+"b469"+STR$(Y%)+"Z";
1590  PRINT EC$+"*d0"+STR$(Y%-4)+"O"+RIGHT$(STR$(A%),2);
1600 NEXT A%
1610 PRINT EC$+"*m0B";
1620 REM plot measurements
1630 PRINT EC$+"*pa20,10Z"; : REM start with pen up
1640 SOT%=&H560 : REM SDA
1650 T0=TIME
1660 FOR A%=0 TO NX%
1670  CALL ENTERCNT%(BUFFER$,SOT%,RET%)
1680  IF RET%=-1 THEN PRINT "ERROR: ENTERCNT" : STOP
1690  U=VAL(LEFT$(BUFFER$,11))
1700  PRINT EC$+"*d382,177O"+"N ="+STR$(A%)
1710  PRINT USING "U =###.#### V";U
1720  PRINT EC$+"*p"+STR$(FNX%(A%))+","+STR$(FNY%(U))+"B";
1730  VOLTS(A%)=U
1740  TSECS(A%)=TIME-T0
1750 NEXT A%
1760 REM
1770 PRINT EC$+"*dE"; : REM ALPHA on
1780 TALK%=&H1F : LISTEN%=&H1F
1790 CALL ADDRESS%(TALK%,LISTEN%,RET%)
1800 IF RET%=-1 THEN PRINT "ERROR: UNT, UNL" : STOP
1810 REM
1820 DEF SEG
1830 FOR A%=0 TO NX%
1840  PRINT USING "####  #####.## s  ###.#### V";A%,TSECS(A%),VOLTS(A%)
1850 NEXT A%
1860 END
